          "required": true,
          "title": "04 · Hitung depresiasi",
          "competencyIds": [
            "penyusutan"
          ],
          "prompt": "Dengan biaya perolehan Rp128 juta, nilai residu Rp8 juta dan umur manfaat 5 tahun, berapa beban penyusutan garis lurus per tahun? Ketik angka rupiah tanpa simbol.",
          "unit": "IDR",
          "hints": ["Kurangi biaya perolehan dengan nilai residu terlebih dahulu.", "Bagikan jumlah tersusutkan dengan masa manfaat."],
          "remediation": { "onIncorrect": { "targetBlockId": "tabel-penyusutan" } },
