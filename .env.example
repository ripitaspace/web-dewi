# Local SQLite database. Use an absolute path on a persistent server in production.
DATABASE_URL="file:./dev.db"

# Public application URL, without a trailing slash
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Google Cloud OAuth 2.0 web application
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
ADMIN_GOOGLE_EMAIL=""

# Generate independent random secrets. BOOKING_ENCRYPTION_KEY accepts 32 bytes
# encoded as hex or base64; the other values should be long random strings.
BOOKING_ENCRYPTION_KEY=""
BOOKING_SESSION_SECRET=""
RATE_LIMIT_SALT=""

# Cloudflare Turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

# Used by Vercel Cron when calling /api/booking/maintenance
CRON_SECRET=""

# Existing content integration
NOTION_TOKEN=""
NOTION_BLOG_DATABASE_ID=""
NOTION_PROGRAM_DATABASE_ID=""
NOTION_TEAM_DATABASE_ID=""
NOTION_PUBLICATIONS_DATABASE_ID=""
