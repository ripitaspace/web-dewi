# Local SQLite database. Use an absolute path on a persistent server in production.
DATABASE_URL="file:./dev.db"

# Public application URL, without a trailing slash
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Google Analytics 4. Create a Web data stream, then place its Measurement ID here.
# Example: G-ABC123DEF4. This is a public identifier, not a secret.
NEXT_PUBLIC_GA_MEASUREMENT_ID=""

# Umami Cloud: powers the public floating visitor stamp with the all-time unique
# visitor total. Create an API key in Umami Settings > API keys; keep it private.
UMAMI_API_KEY=""
# Optional: defaults to the website ID used by the Umami tracking script.
UMAMI_WEBSITE_ID=""
# Optional: only set this when using a regional or self-hosted Umami API endpoint.
UMAMI_API_ENDPOINT=""

# Google Cloud OAuth 2.0 web application
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
ADMIN_GOOGLE_EMAIL=""

# Generate independent random secrets. BOOKING_ENCRYPTION_KEY accepts 32 bytes
# encoded as hex or base64; the other values should be long random strings.
BOOKING_ENCRYPTION_KEY=""
BOOKING_SESSION_SECRET=""
RATE_LIMIT_SALT=""

# Cloudflare Turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

# Used by Vercel Cron when calling /api/booking/maintenance
CRON_SECRET=""

# Existing content integration
NOTION_TOKEN=""
NOTION_BLOG_DATABASE_ID=""
NOTION_PROGRAM_DATABASE_ID=""
NOTION_TEAM_DATABASE_ID=""
NOTION_PUBLICATIONS_DATABASE_ID=""
